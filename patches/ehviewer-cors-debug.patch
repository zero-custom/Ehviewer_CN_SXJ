@@ -0,0 +1,265 @@
+package com.hippo.ehviewer.client;
+
+import androidx.annotation.Nullable;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.locks.Condition;
+import java.util.concurrent.locks.ReentrantLock;
+
+/**
+ * In-memory CORS diagnostics log. No data is written to disk.
+ *
+ * <p>Entries are kept in a bounded ring and exposed to the local HTTP API in
+ * {@link CorsLogServer}. The log deliberately stores no cookies or request
+ * headers; callers only pass the fields they want to inspect.</p>
+ */
+public final class CorsLog {
+
+    public static final int CAPACITY = 2000;
+    private static final int MAX_STRING_LENGTH = 1024;
+
+    private static final CorsLog INSTANCE = new CorsLog();
+
+    public static CorsLog get() {
+        return INSTANCE;
+    }
+
+    public static final class Entry {
+        public final long seq;
+        public final long ts;
+        public final String event;
+        public final String thread;
+        public final JSONObject data;
+
+        Entry(long seq, long ts, String event, String thread, JSONObject data) {
+            this.seq = seq;
+            this.ts = ts;
+            this.event = event;
+            this.thread = thread;
+            this.data = data;
+        }
+
+        public JSONObject toJson() {
+            JSONObject o = new JSONObject();
+            try {
+                o.put("seq", seq);
+                o.put("ts", ts);
+                o.put("event", event);
+                o.put("thread", thread);
+                o.put("data", data);
+            } catch (JSONException ignored) {
+            }
+            return o;
+        }
+    }
+
+    private final ArrayDeque<Entry> entries = new ArrayDeque<>(CAPACITY);
+    private final ReentrantLock lock = new ReentrantLock();
+    private final Condition changed = lock.newCondition();
+
+    private long nextSeq = 1;
+    private long lastClearedSeq = 0;
+
+    private CorsLog() {
+    }
+
+    public void log(String event, @Nullable JSONObject data) {
+        JSONObject payload = data == null ? new JSONObject() : data;
+        lock.lock();
+        try {
+            long seq = nextSeq++;
+            Entry entry = new Entry(seq, System.currentTimeMillis(), event,
+                    Thread.currentThread().getName(), payload);
+            entries.addLast(entry);
+            while (entries.size() > CAPACITY) {
+                entries.removeFirst();
+            }
+            changed.signalAll();
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    public List<Entry> snapshot(long after, int limit) {
+        lock.lock();
+        try {
+            return snapshotLocked(after, limit);
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    public List<Entry> await(long after, int limit, long waitMs) throws InterruptedException {
+        lock.lock();
+        try {
+            long floor = Math.max(after, lastClearedSeq);
+            long deadline = System.currentTimeMillis() + Math.max(0L, waitMs);
+            while (true) {
+                List<Entry> out = snapshotLocked(floor, limit);
+                if (!out.isEmpty() || waitMs <= 0L) {
+                    return out;
+                }
+                long remaining = deadline - System.currentTimeMillis();
+                if (remaining <= 0L) {
+                    return out;
+                }
+                changed.await(remaining, TimeUnit.MILLISECONDS);
+                floor = Math.max(floor, lastClearedSeq);
+            }
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    private List<Entry> snapshotLocked(long after, int limit) {
+        long floor = Math.max(after, lastClearedSeq);
+        int max = Math.max(1, Math.min(limit, CAPACITY));
+        List<Entry> out = new ArrayList<>();
+        for (Entry entry : entries) {
+            if (entry.seq > floor) {
+                out.add(entry);
+                if (out.size() >= max) {
+                    break;
+                }
+            }
+        }
+        return out;
+    }
+
+    public int clear() {
+        lock.lock();
+        try {
+            int cleared = entries.size();
+            lastClearedSeq = nextSeq - 1;
+            entries.clear();
+            changed.signalAll();
+            return cleared;
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    public long lastSeq() {
+        lock.lock();
+        try {
+            return nextSeq - 1;
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    public int size() {
+        lock.lock();
+        try {
+            return entries.size();
+        } finally {
+            lock.unlock();
+        }
+    }
+
+    /**
+     * Builds a JSON payload from alternating key/value pairs. String values are
+     * bounded so a single URL cannot grow the buffer without limit.
+     */
+    public static JSONObject obj(Object... keyValues) {
+        JSONObject o = new JSONObject();
+        if (keyValues == null) {
+            return o;
+        }
+        for (int i = 0; i + 1 < keyValues.length; i += 2) {
+            String key = String.valueOf(keyValues[i]);
+            Object value = keyValues[i + 1];
+            if (value instanceof String) {
+                String s = (String) value;
+                if (s.length() > MAX_STRING_LENGTH) {
+                    value = s.substring(0, MAX_STRING_LENGTH) + "...";
+                }
+            }
+            try {
+                o.put(key, value == null ? JSONObject.NULL : value);
+            } catch (JSONException ignored) {
+            }
+        }
+        return o;
+    }
+
+    public static void request(String source, String url, String requestUrl, boolean proxied,
+                               int attempt, int index) {
+        get().log("image.request", obj(
+                "source", source,
+                "url", url,
+                "requestUrl", requestUrl,
+                "proxied", proxied,
+                "attempt", attempt,
+                "index", index));
+    }
+
+    public static void response(String source, String url, int status, @Nullable String contentType,
+                                long contentLength, long elapsedMs, boolean proxied, int index) {
+        get().log("image.response", obj(
+                "source", source,
+                "url", url,
+                "status", status,
+                "contentType", contentType,
+                "contentLength", contentLength,
+                "elapsedMs", elapsedMs,
+                "proxied", proxied,
+                "index", index));
+    }
+
+    public static void fallback(String source, String url, String reason, boolean proxied,
+                                int status, @Nullable String contentType, int index,
+                                @Nullable String message) {
+        get().log("image.fallback", obj(
+                "source", source,
+                "url", url,
+                "reason", reason,
+                "proxied", proxied,
+                "status", status,
+                "contentType", contentType,
+                "index", index,
+                "message", message));
+    }
+
+    public static void retry(String source, String url, String reason, int index) {
+        get().log("image.retry", obj(
+                "source", source,
+                "url", url,
+                "reason", reason,
+                "next", "original",
+                "index", index));
+    }
+
+    public static void result(String source, String url, boolean ok, long bytes,
+                              long elapsedMs, boolean proxied, int index) {
+        get().log("image.result", obj(
+                "source", source,
+                "url", url,
+                "ok", ok,
+                "bytes", bytes,
+                "elapsedMs", elapsedMs,
+                "proxied", proxied,
+                "index", index));
+    }
+
+    public static void redirect(String source, String from, String to, boolean suppressed) {
+        get().log("image.redirect", obj(
+                "source", source,
+                "from", from,
+                "to", to,
+                "suppressed", suppressed));
+    }
+
+    public static void config(boolean enabled, String serverRaw, @Nullable String serverNormalized) {
+        get().log("cors.config", obj(
+                "enabled", enabled,
+                "serverRaw", serverRaw,
+                "serverNormalized", serverNormalized));
+    }
+}
