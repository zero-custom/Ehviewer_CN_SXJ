@@ -0,0 +1,94 @@
+package com.hippo.ehviewer.client;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+import java.util.List;
+
+@RunWith(RobolectricTestRunner.class)
+public class CorsLogTest {
+
+    @Test
+    public void appendsAndFiltersBySeq() {
+        CorsLog log = CorsLog.get();
+        log.clear();
+        long start = log.lastSeq();
+
+        log.log("test.a", CorsLog.obj("url", "https://example.com/a"));
+        log.log("test.b", CorsLog.obj("n", 1));
+
+        List<CorsLog.Entry> all = log.snapshot(start, 10);
+        assertEquals(2, all.size());
+        assertEquals("test.a", all.get(0).event);
+        assertEquals("test.b", all.get(1).event);
+
+        List<CorsLog.Entry> after = log.snapshot(all.get(0).seq, 10);
+        assertEquals(1, after.size());
+        assertEquals("test.b", after.get(0).event);
+    }
+
+    @Test
+    public void capacityEvictsOldest() {
+        CorsLog log = CorsLog.get();
+        log.clear();
+        for (int i = 0; i < CorsLog.CAPACITY + 5; i++) {
+            log.log("test.n", CorsLog.obj("n", i));
+        }
+
+        List<CorsLog.Entry> all = log.snapshot(0, CorsLog.CAPACITY + 10);
+        assertEquals(CorsLog.CAPACITY, all.size());
+        assertEquals(log.lastSeq() - CorsLog.CAPACITY + 1, all.get(0).seq);
+    }
+
+    @Test
+    public void clearHidesOldSeq() {
+        CorsLog log = CorsLog.get();
+        log.clear();
+        log.log("test.a", CorsLog.obj("n", 1));
+        long oldSeq = log.snapshot(0, 10).get(0).seq;
+
+        int cleared = log.clear();
+        assertTrue(cleared >= 1);
+        assertTrue(log.snapshot(0, 10).isEmpty());
+        assertTrue(log.snapshot(oldSeq, 10).isEmpty());
+
+        log.log("test.b", CorsLog.obj("n", 2));
+        List<CorsLog.Entry> entries = log.snapshot(0, 10);
+        assertEquals(1, entries.size());
+        assertEquals("test.b", entries.get(0).event);
+    }
+
+    @Test
+    public void awaitReturnsNewEntry() throws Exception {
+        CorsLog log = CorsLog.get();
+        log.clear();
+        long start = log.lastSeq();
+
+        Thread writer = new Thread(() -> {
+            try {
+                Thread.sleep(100L);
+            } catch (InterruptedException ignored) {
+            }
+            log.log("test.async", CorsLog.obj("n", 1));
+        });
+        writer.start();
+
+        List<CorsLog.Entry> entries = log.await(start, 10, 2000L);
+        writer.join();
+        assertFalse(entries.isEmpty());
+        assertEquals("test.async", entries.get(0).event);
+    }
+
+    @Test
+    public void awaitTimesOutWithoutNewEntries() throws Exception {
+        CorsLog log = CorsLog.get();
+        log.clear();
+        long start = log.lastSeq();
+        assertTrue(log.await(start, 10, 50L).isEmpty());
+    }
+}
