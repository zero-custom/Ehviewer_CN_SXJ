@@ -0,0 +1,450 @@
+package com.hippo.ehviewer.client;
+
+import android.text.TextUtils;
+
+import com.hippo.ehviewer.BuildConfig;
+import com.hippo.ehviewer.Settings;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.BufferedInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.NetworkInterface;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.net.SocketTimeoutException;
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Enumeration;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Semaphore;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Fork-only, read-only HTTP endpoint exposing {@link CorsLog}.
+ *
+ * <p>Binds 0.0.0.0:18765 with no authentication. The settings screen shows a
+ * warning; the API must never be exposed on an untrusted network.</p>
+ */
+public final class CorsLogServer {
+
+    public static final int PORT = 18765;
+
+    private static final int MAX_CONNECTIONS = 8;
+    private static final int READ_TIMEOUT_MS = 5000;
+    private static final int MAX_HEADER_BYTES = 8192;
+
+    private static final CorsLogServer INSTANCE = new CorsLogServer();
+
+    public static CorsLogServer get() {
+        return INSTANCE;
+    }
+
+    private final AtomicBoolean running = new AtomicBoolean(false);
+    private final Semaphore slots = new Semaphore(MAX_CONNECTIONS);
+
+    private volatile ServerSocket serverSocket;
+    private volatile Thread acceptThread;
+    private volatile ExecutorService workers;
+    private volatile String lastError;
+
+    private CorsLogServer() {
+    }
+
+    public synchronized boolean start() {
+        if (running.get()) {
+            return true;
+        }
+        try {
+            ServerSocket socket = new ServerSocket();
+            serverSocket = socket;
+            socket.setReuseAddress(true);
+            socket.bind(new InetSocketAddress("0.0.0.0", PORT));
+            socket.setSoTimeout(1000);
+            lastError = null;
+            running.set(true);
+            workers = Executors.newFixedThreadPool(4, r -> {
+                Thread t = new Thread(r, "CorsLogHttp");
+                t.setDaemon(true);
+                return t;
+            });
+            acceptThread = new Thread(this::acceptLoop, "CorsLogAccept");
+            acceptThread.setDaemon(true);
+            acceptThread.start();
+            CorsLog.get().log("logapi.start", CorsLog.obj(
+                    "port", PORT,
+                    "addresses", joinAddresses(getLanAddresses())));
+            return true;
+        } catch (Exception e) {
+            lastError = e.getMessage();
+            ServerSocket failed = serverSocket;
+            serverSocket = null;
+            if (failed != null) {
+                try {
+                    failed.close();
+                } catch (IOException ignored) {
+                }
+            }
+            CorsLog.get().log("logapi.error", CorsLog.obj(
+                    "message", String.valueOf(e)));
+            return false;
+        }
+    }
+
+    public synchronized void stop() {
+        if (!running.getAndSet(false)) {
+            return;
+        }
+        ServerSocket socket = serverSocket;
+        serverSocket = null;
+        if (socket != null) {
+            try {
+                socket.close();
+            } catch (IOException ignored) {
+            }
+        }
+        Thread thread = acceptThread;
+        acceptThread = null;
+        if (thread != null) {
+            thread.interrupt();
+        }
+        ExecutorService pool = workers;
+        workers = null;
+        if (pool != null) {
+            pool.shutdownNow();
+        }
+        CorsLog.get().log("logapi.stop", CorsLog.obj("port", PORT));
+    }
+
+    public boolean isRunning() {
+        return running.get();
+    }
+
+    public int getPort() {
+        return PORT;
+    }
+
+    public String getLastError() {
+        return lastError;
+    }
+
+    public static List<String> getLanAddresses() {
+        List<String> addresses = new ArrayList<>();
+        try {
+            Enumeration<NetworkInterface> interfaces = NetworkInterface.getNetworkInterfaces();
+            while (interfaces != null && interfaces.hasMoreElements()) {
+                NetworkInterface network = interfaces.nextElement();
+                if (!network.isUp() || network.isLoopback()) {
+                    continue;
+                }
+                Enumeration<InetAddress> inetAddresses = network.getInetAddresses();
+                while (inetAddresses.hasMoreElements()) {
+                    InetAddress address = inetAddresses.nextElement();
+                    if (address instanceof Inet4Address
+                            && !address.isLoopbackAddress()
+                            && !address.isLinkLocalAddress()) {
+                        addresses.add(address.getHostAddress());
+                    }
+                }
+            }
+        } catch (Exception ignored) {
+        }
+        if (addresses.isEmpty()) {
+            addresses.add("127.0.0.1");
+        }
+        return addresses;
+    }
+
+    private static String joinAddresses(List<String> addresses) {
+        StringBuilder builder = new StringBuilder();
+        for (String address : addresses) {
+            if (builder.length() > 0) {
+                builder.append(", ");
+            }
+            builder.append(address);
+        }
+        return builder.toString();
+    }
+
+    private void acceptLoop() {
+        while (running.get()) {
+            ServerSocket server = serverSocket;
+            if (server == null) {
+                break;
+            }
+            try {
+                Socket socket = server.accept();
+                ExecutorService pool = workers;
+                if (pool != null) {
+                    pool.execute(() -> handle(socket));
+                } else {
+                    closeQuietly(socket);
+                }
+            } catch (SocketTimeoutException ignored) {
+            } catch (IOException e) {
+                if (running.get()) {
+                    lastError = e.getMessage();
+                    CorsLog.get().log("logapi.error", CorsLog.obj("message", String.valueOf(e)));
+                }
+                break;
+            }
+        }
+    }
+
+    private void handle(Socket socket) {
+        if (!slots.tryAcquire()) {
+            writeResponse(socket, 503, "Service Unavailable", "{\"error\":\"busy\"}",
+                    "application/json; charset=utf-8");
+            closeQuietly(socket);
+            return;
+        }
+        try {
+            socket.setSoTimeout(READ_TIMEOUT_MS);
+            Request request = readRequest(socket);
+            if (request == null) {
+                writeResponse(socket, 400, "Bad Request", "{\"error\":\"bad request\"}",
+                        "application/json; charset=utf-8");
+                return;
+            }
+            route(socket, request);
+        } catch (Exception e) {
+            CorsLog.get().log("logapi.error", CorsLog.obj("message", String.valueOf(e)));
+            writeResponse(socket, 500, "Internal Server Error", "{\"error\":\"internal\"}",
+                    "application/json; charset=utf-8");
+        } finally {
+            closeQuietly(socket);
+            slots.release();
+        }
+    }
+
+    private void route(Socket socket, Request request) throws IOException {
+        String path = request.path;
+        if ("/".equals(path)) {
+            if (!"GET".equals(request.method)) {
+                methodNotAllowed(socket);
+                return;
+            }
+            String text = "CORS log API\n"
+                    + "GET /status\n"
+                    + "GET /logs?after=<seq>&limit=<n>&wait=<ms>\n"
+                    + "DELETE /logs\n";
+            writeResponse(socket, 200, "OK", text, "text/plain; charset=utf-8");
+            return;
+        }
+        if ("/status".equals(path)) {
+            if (!"GET".equals(request.method)) {
+                methodNotAllowed(socket);
+                return;
+            }
+            writeResponse(socket, 200, "OK", statusJson().toString(),
+                    "application/json; charset=utf-8");
+            return;
+        }
+        if ("/logs".equals(path)) {
+            if ("GET".equals(request.method)) {
+                handleLogs(socket, request.query);
+            } else if ("DELETE".equals(request.method)) {
+                int cleared = CorsLog.get().clear();
+                JSONObject body = new JSONObject();
+                try {
+                    body.put("ok", true);
+                    body.put("cleared", cleared);
+                } catch (Exception ignored) {
+                }
+                writeResponse(socket, 200, "OK", body.toString(),
+                        "application/json; charset=utf-8");
+            } else {
+                methodNotAllowed(socket);
+            }
+            return;
+        }
+        writeResponse(socket, 404, "Not Found", "{\"error\":\"not found\"}",
+                "application/json; charset=utf-8");
+    }
+
+    private void handleLogs(Socket socket, Map<String, String> query) throws IOException {
+        long after;
+        int limit;
+        long wait;
+        try {
+            after = parseLong(query.get("after"), 0L);
+            limit = (int) Math.max(1L, Math.min(parseLong(query.get("limit"), 200L), 1000L));
+            wait = Math.max(0L, Math.min(parseLong(query.get("wait"), 0L), 30000L));
+        } catch (NumberFormatException e) {
+            writeResponse(socket, 400, "Bad Request", "{\"error\":\"bad parameter\"}",
+                    "application/json; charset=utf-8");
+            return;
+        }
+
+        List<CorsLog.Entry> entries;
+        try {
+            entries = CorsLog.get().await(after, limit, wait);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            entries = new ArrayList<>();
+        }
+
+        JSONArray array = new JSONArray();
+        for (CorsLog.Entry entry : entries) {
+            array.put(entry.toJson());
+        }
+        JSONObject body = new JSONObject();
+        try {
+            body.put("entries", array);
+            body.put("lastSeq", CorsLog.get().lastSeq());
+        } catch (Exception ignored) {
+        }
+        writeResponse(socket, 200, "OK", body.toString(),
+                "application/json; charset=utf-8");
+    }
+
+    private JSONObject statusJson() {
+        JSONObject body = new JSONObject();
+        try {
+            body.put("version", BuildConfig.VERSION_NAME);
+            body.put("versionCode", BuildConfig.VERSION_CODE);
+            body.put("corsEnabled", Settings.getCorsImageEnabled());
+            String rawServer = Settings.getCorsImageServer();
+            String normalizedServer = CorsImageProxy.normalizeServer(rawServer);
+            body.put("corsServerRaw", rawServer == null ? JSONObject.NULL : rawServer);
+            body.put("corsServerNormalized",
+                    normalizedServer == null ? JSONObject.NULL : normalizedServer);
+            body.put("logApiEnabled", Settings.getCorsLogEnabled());
+            body.put("port", PORT);
+            body.put("lastSeq", CorsLog.get().lastSeq());
+            body.put("bufferSize", CorsLog.CAPACITY);
+            body.put("buffered", CorsLog.get().size());
+            body.put("lastError", lastError == null ? JSONObject.NULL : lastError);
+        } catch (Exception ignored) {
+        }
+        return body;
+    }
+
+    private static long parseLong(String value, long fallback) {
+        if (value == null || value.isEmpty()) {
+            return fallback;
+        }
+        return Long.parseLong(value);
+    }
+
+    private void methodNotAllowed(Socket socket) throws IOException {
+        writeResponse(socket, 405, "Method Not Allowed", "{\"error\":\"method not allowed\"}",
+                "application/json; charset=utf-8");
+    }
+
+    private static Request readRequest(Socket socket) throws IOException {
+        InputStream input = new BufferedInputStream(socket.getInputStream());
+        ByteArrayOutputStream header = new ByteArrayOutputStream();
+        int b;
+        while ((b = input.read()) != -1) {
+            header.write(b);
+            if (header.size() >= MAX_HEADER_BYTES) {
+                return null;
+            }
+            if (endsWithHeader(header)) {
+                break;
+            }
+        }
+        if (header.size() == 0) {
+            return null;
+        }
+        String text = header.toString(StandardCharsets.UTF_8.name());
+        int lineEnd = text.indexOf("\r\n");
+        if (lineEnd < 0) {
+            return null;
+        }
+        String line = text.substring(0, lineEnd);
+        String[] parts = line.split(" ");
+        if (parts.length < 2) {
+            return null;
+        }
+        return new Request(parts[0], parts[1]);
+    }
+
+    private static boolean endsWithHeader(ByteArrayOutputStream header) {
+        byte[] bytes = header.toByteArray();
+        int n = bytes.length;
+        return n >= 4
+                && bytes[n - 4] == '\r'
+                && bytes[n - 3] == '\n'
+                && bytes[n - 2] == '\r'
+                && bytes[n - 1] == '\n';
+    }
+
+    private static void writeResponse(Socket socket, int code, String reason, String body,
+                                      String contentType) {
+        try {
+            byte[] bytes = body.getBytes(StandardCharsets.UTF_8);
+            String headers = "HTTP/1.1 " + code + " " + reason + "\r\n"
+                    + "Content-Type: " + contentType + "\r\n"
+                    + "Content-Length: " + bytes.length + "\r\n"
+                    + "Connection: close\r\n"
+                    + "Access-Control-Allow-Origin: *\r\n"
+                    + "\r\n";
+            OutputStream output = socket.getOutputStream();
+            output.write(headers.getBytes(StandardCharsets.UTF_8));
+            output.write(bytes);
+            output.flush();
+        } catch (IOException ignored) {
+        }
+    }
+
+    private static void closeQuietly(Socket socket) {
+        if (socket != null) {
+            try {
+                socket.close();
+            } catch (IOException ignored) {
+            }
+        }
+    }
+
+    private static final class Request {
+        final String method;
+        final String path;
+        final Map<String, String> query;
+
+        Request(String method, String target) {
+            this.method = method;
+            int question = target.indexOf('?');
+            if (question >= 0) {
+                this.path = target.substring(0, question);
+                this.query = parseQuery(target.substring(question + 1));
+            } else {
+                this.path = target;
+                this.query = new HashMap<>();
+            }
+        }
+
+        private static Map<String, String> parseQuery(String raw) {
+            Map<String, String> query = new HashMap<>();
+            if (TextUtils.isEmpty(raw)) {
+                return query;
+            }
+            for (String pair : raw.split("&")) {
+                int equals = pair.indexOf('=');
+                try {
+                    if (equals >= 0) {
+                        query.put(URLDecoder.decode(pair.substring(0, equals), "UTF-8"),
+                                URLDecoder.decode(pair.substring(equals + 1), "UTF-8"));
+                    } else {
+                        query.put(URLDecoder.decode(pair, "UTF-8"), "");
+                    }
+                } catch (Exception ignored) {
+                }
+            }
+            return query;
+        }
+    }
+}
